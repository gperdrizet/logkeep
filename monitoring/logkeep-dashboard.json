{
  "dashboard": {
    "title": "LogKeep Production Monitoring",
    "tags": ["logkeep", "production"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Application Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "up{job=\"logkeep-blue\"}",
            "refId": "A",
            "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"}
          }
        ],
        "options": {
          "reduceOptions": {"calcs": ["lastNotNull"]},
          "text": {"titleSize": 16, "valueSize": 48},
          "colorMode": "value",
          "graphMode": "none"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": "0", "text": "Down", "color": "red"},
              {"type": "value", "value": "1", "text": "Up", "color": "green"}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Database Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "up{job=\"postgres\"}",
            "refId": "A",
            "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"}
          }
        ],
        "options": {
          "reduceOptions": {"calcs": ["lastNotNull"]},
          "text": {"titleSize": 16, "valueSize": 48},
          "colorMode": "value",
          "graphMode": "none"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": "0", "text": "Down", "color": "red"},
              {"type": "value", "value": "1", "text": "Up", "color": "green"}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Prometheus Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "up{job=\"prometheus\"}",
            "refId": "A",
            "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"}
          }
        ],
        "options": {
          "reduceOptions": {"calcs": ["lastNotNull"]},
          "text": {"titleSize": 16, "valueSize": 48},
          "colorMode": "value",
          "graphMode": "none"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": "0", "text": "Down", "color": "red"},
              {"type": "value", "value": "1", "text": "Up", "color": "green"}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Grafana Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "up{job=\"grafana\"}",
            "refId": "A",
            "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"}
          }
        ],
        "options": {
          "reduceOptions": {"calcs": ["lastNotNull"]},
          "text": {"titleSize": 16, "valueSize": 48},
          "colorMode": "value",
          "graphMode": "none"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": "0", "text": "Down", "color": "red"},
              {"type": "value", "value": "1", "text": "Up", "color": "green"}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Container Memory Usage",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "pg_stat_database_tup_fetched{datname=\"logkeep\"}",
            "legendFormat": "Tuples Fetched",
            "refId": "A",
            "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"}
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "color": {"mode": "palette-classic"},
            "custom": {
              "axisLabel": "Memory",
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10,
              "showPoints": "never"
            }
          }
        },
        "options": {
          "tooltip": {"mode": "multi"},
          "legend": {"displayMode": "list", "placement": "bottom"}
        }
      },
      {
        "id": 6,
        "title": "Container CPU Usage",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "pg_stat_database_tup_returned{datname=\"logkeep\"}",
            "legendFormat": "Tuples Returned",
            "refId": "A",
            "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"}
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": {"mode": "palette-classic"},
            "custom": {
              "axisLabel": "CPU %",
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10,
              "showPoints": "never"
            }
          }
        },
        "options": {
          "tooltip": {"mode": "multi"},
          "legend": {"displayMode": "list", "placement": "bottom"}
        }
      },
      {
        "id": 7,
        "title": "Total Links in Database",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 12},
        "targets": [
          {
            "queryType": "sql",
            "rawSql": "SELECT COUNT(*) as value FROM links",
            "refId": "A",
            "datasource": {"type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C"}
          }
        ],
        "options": {
          "reduceOptions": {"calcs": ["lastNotNull"]},
          "text": {"titleSize": 16, "valueSize": 48},
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "blue"}
              ]
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Links by Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 12},
        "targets": [
          {
            "queryType": "sql",
            "rawSql": "SELECT status, COUNT(*) as value FROM links GROUP BY status",
            "refId": "A",
            "datasource": {"type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C"},
            "format": "table"
          }
        ],
        "options": {
          "reduceOptions": {"calcs": ["lastNotNull"]},
          "text": {"titleSize": 14, "valueSize": 24},
          "colorMode": "value",
          "graphMode": "none",
          "orientation": "horizontal"
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Active Users",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 12},
        "targets": [
          {
            "queryType": "sql",
            "rawSql": "SELECT COUNT(*) as value FROM users WHERE is_active = true",
            "refId": "A",
            "datasource": {"type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C"}
          }
        ],
        "options": {
          "reduceOptions": {"calcs": ["lastNotNull"]},
          "text": {"titleSize": 16, "valueSize": 48},
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "title": "Links with Summaries",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 12},
        "targets": [
          {
            "queryType": "sql",
            "rawSql": "SELECT COUNT(*) as value FROM links WHERE summary IS NOT NULL",
            "refId": "A",
            "datasource": {"type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C"}
          }
        ],
        "options": {
          "reduceOptions": {"calcs": ["lastNotNull"]},
          "text": {"titleSize": 16, "valueSize": 48},
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "purple"}
              ]
            }
          }
        }
      },
      {
        "id": 11,
        "title": "Database Connections",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "pg_stat_database_numbackends{datname=\"logkeep\"}",
            "legendFormat": "Active Connections",
            "refId": "A",
            "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"}
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {"mode": "palette-classic"},
            "custom": {
              "axisLabel": "Connections",
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 20,
              "showPoints": "never"
            }
          }
        },
        "options": {
          "tooltip": {"mode": "single"},
          "legend": {"displayMode": "list", "placement": "bottom"}
        }
      },
      {
        "id": 12,
        "title": "Disk Usage",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "pg_stat_database_xact_commit{datname=\"logkeep\"}",
            "legendFormat": "Transactions Committed",
            "refId": "A",
            "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"}
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "color": {"mode": "palette-classic"},
            "custom": {
              "axisLabel": "Disk Space",
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10,
              "showPoints": "never"
            }
          }
        },
        "options": {
          "tooltip": {"mode": "multi"},
          "legend": {"displayMode": "list", "placement": "bottom"}
        }
      }
    ]
  },
  "overwrite": true
}
