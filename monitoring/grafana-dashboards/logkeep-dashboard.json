      "title": "Link submit latency",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 4
      },
      "targets": [
        {
          "expr": "rate(logkeep_request_duration_seconds_sum{environment=\"production\",endpoint=\"/api/links/submit\"}[5m]) / rate(logkeep_request_duration_seconds_count{environment=\"production\",endpoint=\"/api/links/submit\"}[5m])",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
