# Production Environment Configuration Template
# Copy this file to .env.production and fill in the values
# DO NOT commit .env.production to version control!

# =============================================================================
# Application Settings
# =============================================================================

# Secret key for session encryption (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here

# Application environment
ENVIRONMENT=production

# Debug mode (MUST be false in production)
DEBUG=false

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL connection details
POSTGRES_USER=logkeep_admin
POSTGRES_PASSWORD=your-generated-password-here
POSTGRES_DB=logkeep
DATABASE_URL=postgresql://logkeep_admin:your-generated-password-here@postgres:5432/logkeep

# =============================================================================
# Gunicorn Server Configuration
# =============================================================================

# Number of worker processes (recommended: 2 × CPU cores + 1)
GUNICORN_WORKERS=9

# Log level: debug, info, warning, error, critical
LOG_LEVEL=info

# =============================================================================
# Ollama LLM Configuration
# =============================================================================

# Ollama base URL (via SSH tunnel from local machine)
OLLAMA_BASE_URL=http://localhost:11434

# Model to use for summarization
OLLAMA_MODEL=llama3.2:1b

# Summarization timeout (seconds)
OLLAMA_TIMEOUT=90

# =============================================================================
# GitHub Integration
# =============================================================================

# GitHub personal access token for repository sync
# Generate at: https://github.com/settings/tokens
# Required scopes: repo (for private repos) or public_repo (for public repos)
GITHUB_TOKEN=your-github-token-here

# =============================================================================
# Grafana Configuration
# =============================================================================

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-grafana-password-here

# =============================================================================
# Email/SMTP Configuration
# =============================================================================

# SMTP server settings (Ionos)
SMTP_HOST=smtp.ionos.com
SMTP_PORT=465
SMTP_USER=george@perdrizet.org
SMTP_PASSWORD=your-smtp-password-here

# Email alert recipient
ALERT_EMAIL=george@perdrizet.org

# =============================================================================
# Security Settings
# =============================================================================

# Encryption key for sensitive data (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-fernet-key-here

# Session cookie settings
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# =============================================================================
# Backup Configuration
# =============================================================================

# Backup retention periods
BACKUP_DAILY_RETENTION=7
BACKUP_WEEKLY_RETENTION=4
BACKUP_MONTHLY_RETENTION=6

# Remote backup location (local machine)
BACKUP_REMOTE_HOST=gatekeeper
BACKUP_REMOTE_PATH=/mnt/arkk/logkeep/backups
BACKUP_REMOTE_USER=siderealyear

# =============================================================================
# Application URLs
# =============================================================================

# Public application URL
APP_URL=https://logkeep.perdrizet.org

# Grafana dashboard URL
GRAFANA_URL=https://grafana.perdrizet.org

# =============================================================================
# Rate Limiting
# =============================================================================

# API rate limits (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# Summarization rate limit (per user per day)
SUMMARIZATION_LIMIT_PER_DAY=100

# =============================================================================
# Performance Tuning
# =============================================================================

# Database connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# Cache settings (if Redis is added later)
# REDIS_URL=redis://localhost:6379/0
# CACHE_TTL=3600

# =============================================================================
# Monitoring & Observability
# =============================================================================

# Prometheus metrics endpoint
METRICS_ENABLED=true

# Sentry error tracking (optional - add if using Sentry)
# SENTRY_DSN=your-sentry-dsn-here
# SENTRY_ENVIRONMENT=production

# =============================================================================
# Feature Flags
# =============================================================================

# Enable user registration (set to false to make invite-only)
REGISTRATION_ENABLED=false

# Enable public link sharing
PUBLIC_LINKS_ENABLED=false

# Enable AI summarization
SUMMARIZATION_ENABLED=true
