# Production Environment Configuration Template
# Copy this file to .env.production and fill in the values.
# Keep .env.production out of version control.

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------

ENVIRONMENT=production
ADMIN_USERNAMES=admin
MAX_TAGS_PER_USER=1000
MAX_RETRIES=3
PROCESSING_TIMEOUT_MINUTES=5
REQUEST_TIMEOUT=10

# ----------------------------------------------------------------------------
# Server Settings
# ----------------------------------------------------------------------------

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------

# These values are used by the app and by the postgres container in compose.
POSTGRES_USER=logkeep_admin
POSTGRES_PASSWORD=your-generated-password-here
POSTGRES_DB=logkeep
DATABASE_URL=postgresql://logkeep_admin:your-generated-password-here@postgres:5432/logkeep

# ----------------------------------------------------------------------------
# Security
# ----------------------------------------------------------------------------

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=your-session-secret-here

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# ----------------------------------------------------------------------------
# Email / SMTP
# ----------------------------------------------------------------------------

# SMTP_USER is the account used to authenticate to the SMTP server.
# SMTP_FROM is the visible sender address. Default to the same mailbox unless
# your provider supports and authorizes a separate alias.
SMTP_HOST=smtp.ionos.com
SMTP_PORT=465
SMTP_USER=george@perdrizet.org
SMTP_PASSWORD=your-smtp-password-here
SMTP_FROM=george@perdrizet.org

# Optional alert recipient used by the app and docs.
ALERT_EMAIL=george@perdrizet.org

# ----------------------------------------------------------------------------
# LLM Configuration
# ----------------------------------------------------------------------------

# OpenAI-compatible inference endpoint base URL.
# Example: https://api.openai.com/v1
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1

# API key used for Authorization: Bearer <key>
LLM_API_KEY=your-llm-api-key-here

# Model identifier exposed by your provider.
LLM_MODEL_NAME=your-model-name

# ----------------------------------------------------------------------------
# GitHub Integration
# ----------------------------------------------------------------------------

# Add a personal access token here only if you want GitHub sync features.
GITHUB_TOKEN=your-github-token-here

# ----------------------------------------------------------------------------
# Gunicorn Tuning
# ----------------------------------------------------------------------------

GUNICORN_WORKERS=9
GUNICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=50

# ----------------------------------------------------------------------------
# Optional UI / Ops Settings
# ----------------------------------------------------------------------------

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-grafana-password-here
APP_URL=https://logkeep.perdrizet.org
GRAFANA_URL=https://grafana.perdrizet.org