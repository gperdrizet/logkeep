# Session Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=your-session-secret-here-min-32-chars

# Encryption Key for GitHub Tokens
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-here

# Database (PostgreSQL via docker-compose.yml)
# Note: Credentials should match secrets/postgres_*.txt files
DATABASE_URL=postgresql://logkeep_user:your-password@postgres:5432/logkeep

# Configuration
MAX_TAGS_PER_USER=1000
MAX_RETRY_COUNT=3
LOG_LEVEL=INFO

# Application
APP_NAME=LogKeep
APP_HOST=0.0.0.0
APP_PORT=8000

# LLM Configuration (requires GPU with CUDA support)
# Enable/disable article summarization feature
LLM_ENABLED=false
# LLM service endpoint (default: Ollama container)
LLM_BASE_URL=http://ollama:11434
# HuggingFace model name (optimized quantized version)
LLM_MODEL_NAME=hf.co/bartowski/Llama-3.2-1B-Instruct-GGUF
# Request timeout in seconds
LLM_TIMEOUT=90
# Maximum input tokens (affects article truncation)
LLM_MAX_INPUT_TOKENS=4000
# Number of retry attempts for failed summarizations
LLM_MAX_RETRIES=3
# Temperature for summary generation (0.0-1.0, lower = more deterministic)
LLM_TEMPERATURE=0.3
# Automatically summarize on link submission
SUMMARIZE_ON_SUBMIT=true

# Deployment Notes:
# - First startup takes 2-5 minutes to download model
# - Recommended: Daily Ollama container restart for GPU memory management
#   Add cron job: 0 3 * * * docker restart logkeep-ollama
# - Monitor GPU via: docker logs -f logkeep-ollama
# - Backfill existing links: .venv/bin/python src/cli/admin.py backfill-summaries <username>
# - Reset failed summaries: .venv/bin/python src/cli/admin.py reset-summary-retries <username>
