# ============================================================================
# LogKeep Staging Environment Configuration
# ============================================================================
# This file configures the staging environment for testing before production
# deployment. Staging uses a separate database (logkeep_staging) and runs
# on port 8003.
#
# Setup:
#   1. Copy this file to .env.staging
#   2. Fill in secrets (use same encryption/session keys as production)
#   3. Deploy: docker-compose -f docker-compose.staging.yml up -d
# ============================================================================

# ----------------------------------------------------------------------------
# Session Security
# ----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NOTE: Should match production for consistency
SESSION_SECRET=your-session-secret-here-min-32-chars

# ----------------------------------------------------------------------------
# Encryption Key for GitHub Tokens
# ----------------------------------------------------------------------------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NOTE: Should match production so encrypted tokens work in both environments
ENCRYPTION_KEY=your-fernet-encryption-key-here

# ----------------------------------------------------------------------------
# Database (Staging uses separate database)
# ----------------------------------------------------------------------------
# PostgreSQL connection (staging database)
POSTGRES_USER=logkeep_admin
POSTGRES_PASSWORD=your-postgres-password-here
DATABASE_URL=postgresql://logkeep_admin:your-postgres-password-here@postgres:5432/logkeep_staging

# ----------------------------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------------------------
APP_NAME=LogKeep-Staging
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=DEBUG

# Environment identifier
ENVIRONMENT=staging
IS_PRODUCTION=false

# Access token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Link processing settings
MAX_RETRY_COUNT=3
PROCESSING_TIMEOUT_MINUTES=30

# User limits
MAX_TAGS_PER_USER=1000

# ----------------------------------------------------------------------------
# LLM Configuration (Optional - can test without GPU)
# ----------------------------------------------------------------------------
# Enable/disable article summarization feature
LLM_ENABLED=true

# LLM service endpoint
# NOTE: Use same Ollama instance as production via SSH tunnel
LLM_BASE_URL=http://172.18.0.1:11434  # Docker gateway IP

# API key for OpenAI-compatible providers (leave blank for local unauthenticated backends)
LLM_API_KEY=

# HuggingFace model name (optimized quantized version)
LLM_MODEL_NAME=hf.co/bartowski/Llama-3.2-1B-Instruct-GGUF

# Request timeout in seconds
LLM_TIMEOUT=180

# Maximum input tokens (affects article truncation)
LLM_MAX_INPUT_TOKENS=4000

# Maximum output tokens for summary generation
LLM_MAX_OUTPUT_TOKENS=1024

# Number of retry attempts for failed summarizations
LLM_MAX_RETRIES=3

# Temperature for summary generation (0.0-1.0, lower = more deterministic)
LLM_TEMPERATURE=0.3

# Automatically summarize on link submission
SUMMARIZE_ON_SUBMIT=true

# ----------------------------------------------------------------------------
# Gunicorn Configuration (Production Server)
# ----------------------------------------------------------------------------
# Number of worker processes (staging uses fewer than production)
GUNICORN_WORKERS=2
GUNICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=50

# ----------------------------------------------------------------------------
# Monitoring (Shares production monitoring stack)
# ----------------------------------------------------------------------------
# Grafana admin credentials (should match production)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-grafana-password-here

# ----------------------------------------------------------------------------
# SMTP Configuration (Optional - for testing email alerts)
# ----------------------------------------------------------------------------
# Ionos SMTP settings
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
SMTP_USER=your-email@perdrizet.org
SMTP_PASSWORD=your-smtp-password-here

# Alert email address
ALERT_EMAIL=george@perdrizet.org

# ----------------------------------------------------------------------------
# Staging-Specific Notes
# ----------------------------------------------------------------------------
# 
# Database:
# - Staging uses logkeep_staging database (separate from production)
# - Created automatically by init-staging-db.sql script
# - Can be dropped/recreated for clean testing
#
# Port:
# - Staging runs on port 8003 (internal to Docker)
# - Access at http://localhost:8003 or via SSH tunnel
#
# Testing:
# - Test new features here before production deployment
# - Use with CI/CD staging workflow
# - Can restore production backup for realistic testing:
#   ./scripts/restore-db.sh /path/to/backup.sql.gz logkeep_staging
#
# Cleanup:
# - Stop: docker-compose -f docker-compose.staging.yml down
# - Remove data: docker volume rm logkeep_app_data_staging
# - Remove database: docker exec logkeep-postgres psql -U logkeep_admin -c "DROP DATABASE logkeep_staging;"
